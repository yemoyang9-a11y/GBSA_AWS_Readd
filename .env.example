# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ssabi

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Bedrock Models
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# 단일 기본 모델 (2026-08-25) — 난이도 분기 폐지. 챗봇·리캡·배치 전부 이 하나를 쓴다.
BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# 추론 강도. 비우면 output_config 자체를 안 싣는다.
# ⚠️ Sonnet 5 이상에서만 유효하다 — Haiku 4.5·Sonnet 4.5는 이 필드를 거절한다.
BEDROCK_EFFORT=

# 폴백 모델 배선 (2026-08-26) — Nova Lite. 기본 꺼짐. ID는 미검증 추정값(ap-northeast-2
# 리전 접두사 필요 여부 확인 필요). R10/FR-QNA-004 🚦 검증 전 ENABLE_MODEL_FALLBACK 켜지 말 것.
BEDROCK_FALLBACK_MODEL=amazon.nova-lite-v1:0
ENABLE_MODEL_FALLBACK=false

# Server
PORT=3000
NODE_ENV=development
