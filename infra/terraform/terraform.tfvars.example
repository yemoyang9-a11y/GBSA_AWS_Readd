# AWS Configuration
aws_region  = "ap-northeast-2"
aws_profile = "gbsa22"
environment = "prod"

# Project
project_name = "ssabi"

# Database Password (CHANGE THIS!)
db_password = "CHANGE_ME_TO_STRONG_PASSWORD"

# EC2 Key Pair (optional - for SSH access)
# Create a key pair in AWS Console first if you want SSH access
ec2_key_name = ""

# You can override these defaults if needed:
# ec2_instance_type = "t3.medium"
# db_instance_class = "db.t4g.micro"
