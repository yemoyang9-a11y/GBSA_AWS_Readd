# API Base URL
#
# 로컬은 아래 기본값. 배포(Cloudflare Pages)에서는 Fly 백엔드 주소를 쓴다:
#   https://<fly-app-이름>.fly.dev
#
# ⚠️ Vite 는 이 값을 **빌드 시점에 번들에 굽는다.** 런타임 환경변수가 아니다.
#    따라서 배포 값은 Cloudflare Pages 대시보드의 빌드 환경변수로 설정해야 하고,
#    값을 바꾸면 반드시 재빌드해야 반영된다.
#
# ⚠️ 예전 CloudFront 구성에서는 프론트와 API 가 같은 오리진이라 `/api` 접두사를
#    붙였다(https://<cf-도메인>/api). Fly 는 별도 오리진이고 접두사가 없으므로
#    도메인만 적는다 — `/api` 를 붙이면 전 요청이 404 가 된다.
VITE_API_URL=http://localhost:3000

# 환경
VITE_ENV=development

# 백엔드 대역(src/mocks) 사용 여부. 백엔드 엔드포인트가 501 스텁인 동안 화면 개발용으로 켠다.
# 실제 백엔드가 붙으면 false 로 두고 VITE_API_URL 을 가리킨다.
VITE_USE_MOCK=false

# 시연용 고정 디바이스 — 백엔드 DEMO_DEVICE_ID 와 같은 값이어야 한다.
# 비워 두면 브라우저가 최초 실행 시 UUID 를 생성한다 (team-sync §4.8).
VITE_DEMO_DEVICE_ID=
