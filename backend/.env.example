# Environment (test/development/production)
NODE_ENV=development

# Mock Mode (true/false) - DB와 Bedrock 없이 테스트 가능
MOCK_MODE=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ssabi

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Bedrock Models
# 주의: ap-northeast-2에서는 "us." 접두사 추론 프로파일이 유효하지 않음(ValidationException).
# "global." 접두사로 실제 호출 검증 완료 (2026-08-20, R1)
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# 단일 기본 모델 (2026-08-25) — 난이도 분기 폐지. 챗봇·리캡·배치 전부 이 하나를 쓴다.
# 4개 구성 60회 실측으로 Haiku 4.5 선정 — 전 구간 최속이고(요약 11초 vs Sonnet 5 18초),
# 근거 부재 질문에 고정 문구로 3/3 수렴한다(Sonnet 5는 매번 달라져 FR-QNA-004 🚦 위반).
# 미설정 시 BEDROCK_CLAUDE_HAIKU로 폴백한다(기존 .env 호환).
BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# 추론 강도: low | medium | high | xhigh | max. 비우면 output_config 자체를 안 싣는다.
# ⚠️ Sonnet 5 이상에서만 유효하다 — Haiku 4.5·Sonnet 4.5는
#    "output_config.effort: Extra inputs are not permitted"로 요청을 거절한다.
BEDROCK_EFFORT=

# 폴백 모델 배선 (2026-08-26) — Claude 장애 시 Nova Lite로 전환. 기본은 꺼짐
# (FALLBACK_ENABLED = ENABLE_MODEL_FALLBACK=true AND 이 값이 비어있지 않을 때만 켜짐).
# R10/FR-QNA-004 🚦 검증(근거 부재 질문 고정 문구 수렴, Haiku 선정 때와 동일 절차:
# 질문 5종×3회) 전에는 ENABLE_MODEL_FALLBACK을 켜지 말 것.
#
# ⚠️ 아래 ID는 미검증 추정값이다 — Claude가 ap-northeast-2에서 "us." 추론 프로파일이
#    안 먹혀 "global."로 바꾼 전례가 있다(위 참고). Nova도 리전 접두사가 붙는 추론
#    프로파일이 필요할 수 있다("apac.amazon.nova-lite-v1:0" 등). 켜기 전 Bedrock 콘솔
#    Model access에서 ap-northeast-2 기준 정확한 ID를 반드시 확인할 것.
BEDROCK_FALLBACK_MODEL=amazon.nova-lite-v1:0
ENABLE_MODEL_FALLBACK=false

# Server
PORT=3000
