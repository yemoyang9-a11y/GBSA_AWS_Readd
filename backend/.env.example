# Environment (test/development/production)
NODE_ENV=development

# Mock Mode (true/false) - DB와 LLM 없이 테스트 가능
MOCK_MODE=true

# Server
PORT=3000

# --- Database (Supabase) ---
# 2026-08-29: RDS → Supabase. 리전은 도쿄(백엔드 Fly.io 도쿄와 같은 권역이어야
# DB 왕복 지연이 붙지 않는다).
#
# ⚠️ pooler 모드에 주의한다. transaction 모드(6543 포트)는 매 트랜잭션마다 다른 백엔드
#    연결을 배정해서 prepared statement가 깨질 수 있다. session 모드(5432 포트) 또는
#    직접 연결이 안전하다. 자세한 내용은 src/config/database.ts 주석 참조.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 커넥션 풀 크기. 기본 5 — Supabase 동시 연결 상한이 RDS보다 낮고, 실행 단위가
# 컨테이너 1개라 예전 RDS 기준값(20)을 그대로 쓰면 안 된다.
DB_POOL_MAX=5

# --- LLM (Anthropic API) ---
# 2026-08-29: Bedrock → Anthropic API. AWS 계정 폐쇄로 Bedrock을 못 쓴다.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 단일 기본 모델 (2026-08-25) — 난이도 분기 폐지. 챗봇·리캡·배치 전부 이 하나를 쓴다.
# 4개 구성 60회 실측으로 Haiku 4.5 선정 — 전 구간 최속이고(요약 11초 vs Sonnet 5 18초),
# 근거 부재 질문에 고정 문구로 3/3 수렴한다(Sonnet 5는 매번 달라져 FR-QNA-004 🚦 위반).
#
# ⚠️ Anthropic API의 모델 ID는 그 자체로 완결이다. Bedrock처럼 리전 접두사(global.)나
#    날짜·버전 접미사(-20251001-v1:0)를 붙이면 존재하지 않는 ID가 된다.
ANTHROPIC_MODEL=claude-haiku-4-5

# 추론 강도: low | medium | high | xhigh | max. 비우면 output_config 자체를 안 싣는다.
# ⚠️ Sonnet 5 이상에서만 유효하다 — Haiku 4.5·Sonnet 4.5는 이 필드를 거절한다.
ANTHROPIC_EFFORT=

# 폴백 모델은 두지 않는다 (D-2, 2026-08-29) — 단일 모델 + 재시도만.
# 폴백을 두면 R10/FR-QNA-004 🚦(근거 부재 시 고정 문구 수렴)을 모델별로 재검증해야 한다.

# --- Embedding (Cohere) ---
# 2026-08-29 (D-1): Titan은 Bedrock 전용이라 교체. 출력 차원 1024를 유지해
# vector(1024) 스키마와 HNSW 인덱스를 그대로 쓴다.
COHERE_API_KEY=your_cohere_api_key_here

# --- 검증 전용 (배포 환경에 설정하지 않는다) ---
# 시연용 고정 디바이스. 데모 스크립트(run-seed-demo-state.ts)와 같은 값이어야 한다.
DEMO_DEVICE_ID=11111111-1111-4111-8111-111111111111
