# Environment (test/development/production)
NODE_ENV=development

# Mock Mode (true/false) - DB와 LLM 없이 테스트 가능
MOCK_MODE=true

# Server
PORT=3000

# --- Database (Supabase) ---
# 2026-08-29: RDS → Supabase. 리전은 도쿄(백엔드 Fly.io 도쿄와 같은 권역이어야
# DB 왕복 지연이 붙지 않는다).
#
# ⚠️ pooler 모드에 주의한다. transaction 모드(6543 포트)는 매 트랜잭션마다 다른 백엔드
#    연결을 배정해서 prepared statement가 깨질 수 있다. session 모드(5432 포트) 또는
#    직접 연결이 안전하다. 자세한 내용은 src/config/database.ts 주석 참조.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 커넥션 풀 크기. 기본 5 — Supabase 동시 연결 상한이 RDS보다 낮고, 실행 단위가
# 컨테이너 1개라 예전 RDS 기준값(20)을 그대로 쓰면 안 된다.
DB_POOL_MAX=5

# --- LLM (OpenAI Responses API) ---
# NFR-AI-001: one configured model for chatbot, recap and batch; no provider fallback.
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Optional legacy provider: used only when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_EFFORT=
# ANTHROPIC_WORKSPACE_ID=

# --- Embedding (Cohere) ---
# 2026-08-29 (D-1): Titan은 Bedrock 전용이라 교체. 출력 차원 1024를 유지해
# vector(1024) 스키마와 HNSW 인덱스를 그대로 쓴다.
COHERE_API_KEY=your_cohere_api_key_here

# --- 검증 전용 (배포 환경에 설정하지 않는다) ---
# 시연용 고정 디바이스. 데모 스크립트(run-seed-demo-state.ts)와 같은 값이어야 한다.
DEMO_DEVICE_ID=11111111-1111-4111-8111-111111111111
