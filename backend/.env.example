# Environment (test/development/production)
NODE_ENV=development

# Mock Mode (true/false) - DB와 Bedrock 없이 테스트 가능
MOCK_MODE=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ssabi

# AWS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Bedrock Models
# 주의: ap-northeast-2에서는 "us." 접두사 추론 프로파일이 유효하지 않음(ValidationException).
# "global." 접두사로 실제 호출 검증 완료 (2026-08-20, R1)
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CLAUDE_SONNET=global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_CLAUDE_HAIKU=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Server
PORT=3000
